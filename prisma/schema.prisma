// AutomotiveOA — data foundation (CONTEXT.md language).
// M1: Shop, Staff, User. M2: Customer, Vehicle, RepairCase, Photo. M3: Finding.
// M4: ServiceCatalogItem, Job, JobAuthorization, PartLine, Quotation,
// QuotationLine. M5: CaseEvent (the internal timeline), Job.waitingReason,
// and the RepairCase ready/delivered fields.
// Every tenant-owned row carries shop_id (ADR-001); scoping is
// enforced by the tenant guard in lib/tenant.ts, never by hand-written WHERE
// clauses. Cross-model relations join on same-shop composite FKs so the
// database itself rejects cross-shop links (defense in depth, per User→Staff
// in M1).
//
// Money (founder ruling, M4 brief): integer satang (THB minor units) in Int
// columns — exact arithmetic, serializable, no Decimal objects. THB is
// implicit platform-wide in MVP; no currency column, no VAT math.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// The tenant: a garage business using the platform.
model Shop {
  id        String   @id @default(cuid())
  name      String
  /// Last issued Repair Case number, atomically incremented per check-in
  /// (M2 brief §2). Starts at 1000 so the first case is RC-1001.
  caseSeq   Int      @default(1000) @map("case_seq")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  staff          Staff[]
  users          User[]
  customers      Customer[]
  vehicles       Vehicle[]
  repairCases    RepairCase[]
  photos         Photo[]
  findings       Finding[]
  catalogItems   ServiceCatalogItem[]
  jobs           Job[]
  authorizations JobAuthorization[]
  partLines      PartLine[]
  quotations     Quotation[]
  quotationLines QuotationLine[]
  caseEvents     CaseEvent[]

  @@map("shops")
}

/// Everyone who works at the Shop. A Staff record does NOT imply a login —
/// technicians exist here so Jobs can carry an assignee (CONTEXT.md).
model Staff {
  id        String   @id @default(cuid())
  shopId    String   @map("shop_id")
  name      String
  /// Free-text job title ("ที่ปรึกษาบริการ", "ช่างตัวถัง"…) — the staff cast
  /// is a working assumption pending pilot interviews.
  position  String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  shop                   Shop               @relation(fields: [shopId], references: [id])
  user                   User?
  openedCases            RepairCase[]
  uploadedPhotos         Photo[]
  recordedFindings       Finding[]
  createdJobs            Job[]              @relation("JobCreatedBy")
  assignedJobs           Job[]              @relation("JobAssignedStaff")
  priceOverriddenJobs    Job[]              @relation("JobPriceOverriddenBy")
  recordedAuthorizations JobAuthorization[]
  issuedQuotations       Quotation[]
  deliveredCases         RepairCase[]       @relation("CaseDeliveredBy")
  caseEventsActed        CaseEvent[]        @relation("CaseEventActor")
  caseEventsSubject      CaseEvent[]        @relation("CaseEventSubject")

  @@unique([shopId, id]) // target for the same-shop composite FKs (users, cases, photos, findings)
  @@index([shopId])
  @@map("staff")
}

/// A Staff member with a login. MVP: only Manager and Service Advisor.
/// Any Staff can be promoted later without remodeling (CONTEXT.md).
model User {
  id           String   @id @default(cuid())
  shopId       String   @map("shop_id")
  staffId      String   @unique @map("staff_id")
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole
  locale       Locale   @default(th)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  shop  Shop  @relation(fields: [shopId], references: [id])
  // Composite FK on (shop_id, staff_id): the database itself rejects a User
  // pointing at another Shop's Staff (ADR-001 defense in depth).
  staff Staff @relation(fields: [shopId, staffId], references: [shopId, id])

  @@unique([shopId, staffId])
  @@index([shopId])
  @@map("users")
}

enum UserRole {
  MANAGER
  ADVISOR
}

enum Locale {
  th
  en
}

/// Always a person — the one the Shop talks to (CONTEXT.md). Phone is the
/// per-Shop identity key: at check-in the advisor looks up by phone to decide
/// existing-vs-new. History (spending, visits) is relationship data and never
/// transfers with a sold car. Real fleet accounts are deferred (LATER.md).
model Customer {
  id        String   @id @default(cuid())
  shopId    String   @map("shop_id")
  name      String
  /// Normalized to digits only (lib/normalize.ts) — the identity key.
  phone     String
  /// Optional company tag for corporate cars ("Somchai — ABC Logistics").
  company   String?
  note      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  shop            Shop         @relation(fields: [shopId], references: [id])
  primaryVehicles Vehicle[]    @relation("VehiclePrimaryCustomer")
  contactCases    RepairCase[] @relation("CaseContactCustomer")

  @@unique([shopId, phone])
  @@unique([shopId, id]) // target for the same-shop composite FKs
  @@map("customers")
}

/// Selects the Damage Map artwork (DESIGN.md; the map itself arrives in M3).
enum BodyType {
  SEDAN
  PICKUP
}

/// A car (CONTEXT.md). Plate is the everyday lookup key — a returning car
/// wearing a new plate gets its plate edited IN PLACE (history stays, no
/// duplicate Vehicle). Vehicle history is physical truth and stays with the
/// car across owners; ownership changes re-link primaryCustomer at check-in.
model Vehicle {
  id                String   @id @default(cuid())
  shopId            String   @map("shop_id")
  /// Normalized: spaces/dashes stripped (lib/normalize.ts), e.g. "กข1234".
  plate             String
  /// Registration province, free text — optional, disambiguates identical plates.
  province          String?
  /// Optional; usually supplied by insurance cases.
  vin               String?
  bodyType          BodyType @map("body_type")
  make              String?
  model             String?
  color             String?
  primaryCustomerId String   @map("primary_customer_id")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  shop            Shop         @relation(fields: [shopId], references: [id])
  primaryCustomer Customer     @relation("VehiclePrimaryCustomer", fields: [shopId, primaryCustomerId], references: [shopId, id])
  cases           RepairCase[]

  @@unique([shopId, plate])
  @@unique([shopId, id]) // target for the same-shop composite FKs
  @@map("vehicles")
}

/// Lifecycle (CONTEXT.md): Checked In → Ready → Delivered. Everything in
/// between is derived from Jobs and never set by hand. READY is derived in
/// both directions (M5 ruling, lib/case-flow.ts): it flips on the last
/// authorized Job completing and flips back when new work is authorized;
/// DELIVERED is always an explicit staff action, only from READY.
enum RepairCaseStatus {
  CHECKED_IN
  READY
  DELIVERED
}

/// The ticket for one vehicle visit (CONTEXT.md). Opened at check-in, closed
/// at delivery. Carries its own contact person — usually the Vehicle's primary
/// Customer, but whoever actually brought the car.
model RepairCase {
  id                String           @id @default(cuid())
  shopId            String           @map("shop_id")
  /// Human reference like RC-1024 — per-Shop sequence from Shop.caseSeq.
  reference         String
  status            RepairCaseStatus @default(CHECKED_IN)
  vehicleId         String           @map("vehicle_id")
  contactCustomerId String           @map("contact_customer_id")
  /// Visit reason / customer-reported concerns, free text.
  note              String?
  odometerKm        Int?             @map("odometer_km")
  checkedInAt       DateTime         @default(now()) @map("checked_in_at")
  openedByStaffId   String           @map("opened_by_staff_id")
  /// Set while READY (cleared if new work flips the case back — the history
  /// lives in CaseEvents); deliveredAt/By are set once, at handover.
  readyAt            DateTime? @map("ready_at")
  deliveredAt        DateTime? @map("delivered_at")
  deliveredByStaffId String?   @map("delivered_by_staff_id")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  shop            Shop        @relation(fields: [shopId], references: [id])
  vehicle         Vehicle     @relation(fields: [shopId, vehicleId], references: [shopId, id])
  contactCustomer Customer    @relation("CaseContactCustomer", fields: [shopId, contactCustomerId], references: [shopId, id])
  openedByStaff   Staff       @relation(fields: [shopId, openedByStaffId], references: [shopId, id])
  deliveredBy     Staff?      @relation("CaseDeliveredBy", fields: [shopId, deliveredByStaffId], references: [shopId, id])
  photos          Photo[]
  findings        Finding[]
  jobs            Job[]
  quotations      Quotation[]
  events          CaseEvent[]

  @@unique([shopId, reference])
  @@unique([shopId, id]) // target for the same-shop composite FKs
  @@index([shopId, status])
  @@map("repair_cases")
}

/// Where a Finding came from — the Damage Map or the Service Checklist.
/// Two capture surfaces, one record shape (CONTEXT.md).
enum FindingSource {
  DAMAGE_MAP
  CHECKLIST
}

/// Visible body damage kinds, multi-select per Finding ("dent + scratch").
/// Severity is DERIVED, never stored: crack/broken => severe (red hatch),
/// otherwise minor (amber) — DESIGN.md D-3.
enum DamageType {
  SCRATCH
  DENT
  CRACK
  BROKEN
}

/// Checklist wear states that become Findings. OK deliberately does not
/// persist (founder ruling in the M3 brief): only flagged items are stored —
/// they are what the M7 Follow-up worklist reads.
enum FindingCondition {
  DUE_SOON
  NEEDS_WORK
}

/// Proposed next step(s), multi-select — the mockup's "repair + repaint"
/// chip is [REPAIR, REPAINT]. Jobs that fulfil Findings arrive in M4.
enum ProposedAction {
  REPAIR
  REPAINT
  REPLACE
  SERVICE
}

/// One thing an inspection turned up (CONTEXT.md). Damage Map flavor carries
/// `zone` (canonical id from lib/inspection registry — a string, not a DB
/// enum, so a third body type later is code + copy, not a migration);
/// Checklist flavor carries `checklistItem` + `condition`. Multiple Findings
/// per zone are allowed — a hidden crack found mid-repair behind an
/// already-scratched bumper is a second Finding, not an edit. One Finding per
/// checklist item per case (partial unique below; zone rows keep NULL there).
model Finding {
  id            String            @id @default(cuid())
  shopId        String            @map("shop_id")
  caseId        String            @map("case_id")
  source        FindingSource
  /// Canonical body-zone id (DAMAGE_MAP findings; validated in code).
  zone          String?
  /// Canonical checklist-item id (CHECKLIST findings; validated in code).
  checklistItem String?           @map("checklist_item")
  damageTypes   DamageType[]      @map("damage_types")
  condition     FindingCondition?
  proposedActions ProposedAction[] @map("proposed_actions")
  note          String?
  /// The Job fulfilling this Finding (M4). At most one per Finding (founder
  /// ruling): grouping is many Findings → one Job, never a split. NULL =
  /// ungrouped. The composite FK pins the Job to this Finding's own shop AND
  /// case at the database level.
  jobId         String?           @map("job_id")
  /// Who recorded it and when — mid-repair additions stay distinguishable
  /// from the check-in inspection by this timestamp.
  recordedByStaffId String   @map("recorded_by_staff_id")
  recordedAt        DateTime @default(now()) @map("recorded_at")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  shop       Shop       @relation(fields: [shopId], references: [id])
  repairCase RepairCase @relation(fields: [shopId, caseId], references: [shopId, id])
  recordedBy Staff      @relation(fields: [shopId, recordedByStaffId], references: [shopId, id])
  job        Job?       @relation(fields: [shopId, caseId, jobId], references: [shopId, caseId, id])
  photos     Photo[]

  // One checklist Finding per item per case. Postgres unique indexes treat
  // NULLs as distinct, so Damage Map findings (checklistItem NULL) coexist.
  @@unique([shopId, caseId, checklistItem])
  @@unique([shopId, id]) // target for the same-shop composite FKs
  @@unique([shopId, caseId, id]) // target for Photo's same-case FK
  @@index([shopId, caseId])
  @@index([shopId, jobId])
  @@map("findings")
}

/// A photo (CONTEXT.md: attaches at Repair Case / Finding / Job level). Every
/// Photo belongs to its Repair Case; `findingId` (M3) marks Finding evidence,
/// `jobId` (M4) marks Job progress/after-work shots relayed by office staff —
/// both NULL means case-level (the check-in walkaround). A photo links a
/// Finding or a Job, never both (app-level validation).
model Photo {
  id                String   @id @default(cuid())
  shopId            String   @map("shop_id")
  caseId            String   @map("case_id")
  /// Finding evidence when set. The composite FK below pins the Finding to
  /// this photo's own shop AND case — a cross-case link is impossible at the
  /// database level (M2 defense-in-depth idiom).
  findingId         String?  @map("finding_id")
  /// Job progress shot when set — same shop-and-case composite pin as findingId.
  jobId             String?  @map("job_id")
  /// Key into the photo store (lib/storage) — files are served only through
  /// the authenticated, tenant-checked photo route, never a public URL.
  storageKey        String   @unique @map("storage_key")
  contentType       String   @map("content_type")
  sizeBytes         Int      @map("size_bytes")
  capturedAt        DateTime @default(now()) @map("captured_at")
  uploadedByStaffId String   @map("uploaded_by_staff_id")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  shop       Shop       @relation(fields: [shopId], references: [id])
  repairCase RepairCase @relation(fields: [shopId, caseId], references: [shopId, id])
  finding    Finding?   @relation(fields: [shopId, caseId, findingId], references: [shopId, caseId, id])
  job        Job?       @relation(fields: [shopId, caseId, jobId], references: [shopId, caseId, id])
  uploadedBy Staff      @relation(fields: [shopId, uploadedByStaffId], references: [shopId, id])

  @@index([shopId, caseId])
  @@index([shopId, findingId])
  @@index([shopId, jobId])
  @@map("photos")
}

/// The Shop's own price list of standard services (CONTEXT.md). Maintained
/// per Shop by its Manager; names are shop-authored free text in the Shop's
/// own language — tenant data, never i18n copy. Entries deactivate, never
/// delete: Jobs reference them.
model ServiceCatalogItem {
  id          String   @id @default(cuid())
  shopId      String   @map("shop_id")
  name        String
  /// Integer satang (M4 brief money ruling).
  priceSatang Int      @map("price_satang")
  active      Boolean  @default(true)
  note        String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  shop Shop  @relation(fields: [shopId], references: [id])
  jobs Job[]

  @@unique([shopId, id]) // target for Job's same-shop composite FK
  @@index([shopId, active])
  @@map("service_catalog_items")
}

/// Job lifecycle (CONTEXT.md). The enum ships COMPLETE so M5 never alters a
/// Postgres enum — but M4 code only ever writes PROPOSED / AUTHORIZED /
/// DECLINED (working transitions, waiting reasons, and QC are M5).
enum JobStatus {
  PROPOSED
  AUTHORIZED
  WAITING
  IN_PROGRESS
  QC
  COMPLETED
  DECLINED
  CANCELLED
}

/// Who pays for a Job: the Customer (self-pay) or an insurer. The Claim
/// record arrives in M8 — until then `insurerName` free text is the whole
/// insurance surface (M4 brief).
enum PayerType {
  CUSTOMER
  INSURER
}

/// One line of work on a Repair Case (CONTEXT.md): fulfils zero or more
/// Findings (zero = customer-requested service, founder ruling), priced from
/// the Service Catalog (`catalogItemId` set, price locked for Advisors) or
/// quoted by hand (`catalogItemId` NULL — damage/bodywork). `priceSatang`
/// NULL = not yet priced; quotation issue and authorization both require one.
model Job {
  id            String    @id @default(cuid())
  shopId        String    @map("shop_id")
  caseId        String    @map("case_id")
  title         String
  status        JobStatus @default(PROPOSED)
  /// Required while status is WAITING, NULL otherwise (app-validated;
  /// lib/case-flow.ts). Reason history lives in CaseEvents.
  waitingReason WaitingReason? @map("waiting_reason")
  payerType     PayerType @map("payer_type")
  /// Free text while payerType is INSURER (Claim FK arrives in M8).
  insurerName   String?   @map("insurer_name")
  catalogItemId String?   @map("catalog_item_id")
  priceSatang   Int?      @map("price_satang")
  /// Manager who set a catalog Job's price away from the catalog entry —
  /// NULL means no override (CONTEXT.md: regular staff cannot).
  priceOverriddenByStaffId String? @map("price_overridden_by_staff_id")
  assignedStaffId          String? @map("assigned_staff_id")
  note          String?
  createdByStaffId String   @map("created_by_staff_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  shop              Shop                @relation(fields: [shopId], references: [id])
  repairCase        RepairCase          @relation(fields: [shopId, caseId], references: [shopId, id])
  catalogItem       ServiceCatalogItem? @relation(fields: [shopId, catalogItemId], references: [shopId, id])
  priceOverriddenBy Staff?              @relation("JobPriceOverriddenBy", fields: [shopId, priceOverriddenByStaffId], references: [shopId, id])
  assignedStaff     Staff?              @relation("JobAssignedStaff", fields: [shopId, assignedStaffId], references: [shopId, id])
  createdBy         Staff               @relation("JobCreatedBy", fields: [shopId, createdByStaffId], references: [shopId, id])
  findings          Finding[]
  photos            Photo[]
  authorizations    JobAuthorization[]
  partLines         PartLine[]
  quotationLines    QuotationLine[]
  events            CaseEvent[]

  @@unique([shopId, id]) // target for the same-shop composite FKs
  @@unique([shopId, caseId, id]) // target for Finding/Photo same-case FKs
  @@index([shopId, caseId])
  @@map("jobs")
}

/// A recorded payer response, or a Manager revert (M4 brief §4).
enum AuthorizationDecision {
  AUTHORIZED
  DECLINED
  /// Manager-only correction back to PROPOSED — appended, never edited.
  REVERTED
}

/// How the payer's response arrived (CONTEXT.md: LINE chat, phone, in
/// person; insurer decisions arrive outside the system).
enum AuthorizationChannel {
  LINE
  PHONE
  IN_PERSON
  OTHER
}

/// Append-only authorization history for one Job (CONTEXT.md: who recorded
/// it, when, and through which channel). Corrections append, never edit.
model JobAuthorization {
  id       String                @id @default(cuid())
  shopId   String                @map("shop_id")
  jobId    String                @map("job_id")
  decision AuthorizationDecision
  /// Required for AUTHORIZED/DECLINED (app-validated); NULL on REVERTED.
  channel  AuthorizationChannel?
  /// The Quotation version presented to the payer, when staff record one.
  quotationId       String?  @map("quotation_id")
  note              String?
  recordedByStaffId String   @map("recorded_by_staff_id")
  recordedAt        DateTime @default(now()) @map("recorded_at")

  shop       Shop       @relation(fields: [shopId], references: [id])
  job        Job        @relation(fields: [shopId, jobId], references: [shopId, id])
  quotation  Quotation? @relation(fields: [shopId, quotationId], references: [shopId, id])
  recordedBy Staff      @relation(fields: [shopId, recordedByStaffId], references: [shopId, id])

  @@index([shopId, jobId])
  @@map("job_authorizations")
}

/// Part order progress (CONTEXT.md): what a Waiting(Parts) Job is waiting
/// for. The M5 dashboard consumes this; inventory/stock stays out of MVP.
enum PartOrderStatus {
  NOT_ORDERED
  ORDERED
  ARRIVED
}

/// One required part on a Job (CONTEXT.md). `unitCostSatang` is the shop's
/// INTERNAL procurement cost (founder ruling): optional, never summed into
/// the Job's customer-facing price, never printed on quotations.
model PartLine {
  id            String          @id @default(cuid())
  shopId        String          @map("shop_id")
  jobId         String          @map("job_id")
  name          String
  quantity      Int             @default(1)
  unitCostSatang Int?           @map("unit_cost_satang")
  supplier      String?
  orderStatus   PartOrderStatus @default(NOT_ORDERED) @map("order_status")
  etaDate       DateTime?       @map("eta_date") @db.Date
  note          String?
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  shop Shop @relation(fields: [shopId], references: [id])
  job  Job  @relation(fields: [shopId, jobId], references: [shopId, id])

  @@index([shopId, jobId])
  @@map("part_lines")
}

/// A numbered, immutable snapshot of proposed Jobs and their prices
/// (CONTEXT.md). One lineage per case (founder ruling): `number` derives
/// from the case reference (RC-1024 → Q-1024) and `version` counts up per
/// explicit issue. No update path exists anywhere in the app; rows are
/// created complete and never touched again — hence no updatedAt.
model Quotation {
  id            String   @id @default(cuid())
  shopId        String   @map("shop_id")
  caseId        String   @map("case_id")
  number        String
  version       Int
  totalSatang   Int      @map("total_satang")
  issuedByStaffId String   @map("issued_by_staff_id")
  issuedAt        DateTime @default(now()) @map("issued_at")

  shop           Shop               @relation(fields: [shopId], references: [id])
  repairCase     RepairCase         @relation(fields: [shopId, caseId], references: [shopId, id])
  issuedBy       Staff              @relation(fields: [shopId, issuedByStaffId], references: [shopId, id])
  lines          QuotationLine[]
  authorizations JobAuthorization[]
  events         CaseEvent[]

  @@unique([shopId, caseId, version])
  @@unique([shopId, id]) // target for the same-shop composite FKs
  @@index([shopId, caseId])
  @@map("quotations")
}

/// One snapshot line: the Job's title, price, and payer AS OFFERED. The
/// back-link to the live Job is deliberately a single-column FK (not the
/// same-shop composite idiom): ON DELETE SET NULL on a composite FK would
/// null shopId too, so the soft link stands alone — the snapshot must
/// survive anything, including a still-PROPOSED Job being deleted. The
/// line's shop is pinned through its Quotation FK regardless.
model QuotationLine {
  id          String    @id @default(cuid())
  shopId      String    @map("shop_id")
  quotationId String    @map("quotation_id")
  jobId       String?   @map("job_id")
  title       String
  priceSatang Int       @map("price_satang")
  payerType   PayerType @map("payer_type")
  insurerName String?   @map("insurer_name")
  sortOrder   Int       @map("sort_order")

  shop      Shop      @relation(fields: [shopId], references: [id])
  quotation Quotation @relation(fields: [shopId, quotationId], references: [shopId, id])
  job       Job?      @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([shopId, quotationId])
  @@map("quotation_lines")
}

/// Why a Job sits in WAITING — CONTEXT.md's fixed set.
enum WaitingReason {
  PARTS
  PAINT_BOOTH
  TECHNICIAN
  OTHER
}

/// What an internal-timeline entry records (M5 brief, founder ruling: one
/// append-only table for every operational event). QC pass/fail, cancel, and
/// revert get their own types — deriving them from from/to status pairs would
/// make a Manager revert QC→IN_PROGRESS indistinguishable from a QC fail.
enum CaseEventType {
  JOB_CREATED
  JOB_DELETED
  JOB_AUTHORIZATION_RECORDED
  JOB_STATUS_CHANGED
  JOB_WAITING_REASON_CHANGED
  JOB_QC_PASSED
  JOB_QC_FAILED
  JOB_CANCELLED
  JOB_REVERTED
  JOB_ASSIGNED
  JOB_PRICE_OVERRIDDEN
  QUOTATION_ISSUED
  CASE_READY
  CASE_READY_REVOKED
  CASE_DELIVERED
}

/// One internal-timeline entry (CONTEXT.md: the internal timeline records
/// every operational event for Staff). Append-only: rows are written complete
/// in the SAME transaction as the mutation they record and never touched
/// again — no update path, no updatedAt (the Quotation idiom). Staff-only
/// forever: the customer narrative is M6's separately composed LINE Updates,
/// and nothing here ever auto-publishes (ADR-003).
model CaseEvent {
  id     String        @id @default(cuid())
  shopId String        @map("shop_id")
  caseId String        @map("case_id")
  type   CaseEventType
  /// Soft link to the live Job — deliberately the QuotationLine idiom
  /// (single-column FK, ON DELETE SET NULL; a composite FK would null shopId
  /// too). The event's shop stays pinned through its case FK, and the title
  /// snapshot below keeps deleted Jobs renderable.
  jobId    String? @map("job_id")
  /// The Job's title at event time — survives deletion and later renames.
  jobTitle String? @map("job_title")
  fromStatus    JobStatus?     @map("from_status")
  toStatus      JobStatus?     @map("to_status")
  waitingReason WaitingReason? @map("waiting_reason")
  /// JOB_PRICE_OVERRIDDEN: the price the Manager set, in satang.
  priceSatang Int? @map("price_satang")
  /// QUOTATION_ISSUED: a real composite FK is safe here — quotations are
  /// immutable and never deleted.
  quotationId String? @map("quotation_id")
  /// JOB_ASSIGNED: the newly assigned technician (NULL = unassigned).
  subjectStaffId String? @map("subject_staff_id")
  /// Free text carried by the event (QC-fail reason, cancel reason,
  /// authorization note) — shop-authored data, rendered verbatim.
  note         String?
  actorStaffId String   @map("actor_staff_id")
  at           DateTime @default(now()) @map("occurred_at")

  shop         Shop       @relation(fields: [shopId], references: [id])
  repairCase   RepairCase @relation(fields: [shopId, caseId], references: [shopId, id])
  job          Job?       @relation(fields: [jobId], references: [id], onDelete: SetNull)
  quotation    Quotation? @relation(fields: [shopId, quotationId], references: [shopId, id])
  subjectStaff Staff?     @relation("CaseEventSubject", fields: [shopId, subjectStaffId], references: [shopId, id])
  actorStaff   Staff      @relation("CaseEventActor", fields: [shopId, actorStaffId], references: [shopId, id])

  @@index([shopId, caseId, at])
  @@map("case_events")
}
