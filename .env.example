# Copy to .env and fill in. NEVER commit .env (see .gitignore).

# Postgres connection. Local dev: `npm run db:dev` starts a local server and
# prints a URL — replace its database name (template1) with "automotiveoa",
# then `npm run db:migrate` applies the committed migrations.
# Production: a hosted Postgres (e.g. Neon/Supabase) connection string.
DATABASE_URL="postgres://postgres:postgres@localhost:51214/automotiveoa?sslmode=disable"

# Auth.js session encryption secret. Generate with: npx auth secret (or openssl rand -base64 32)
AUTH_SECRET=""

# --- LINE integration (M6) ---
# Encrypts each Shop's LINE channel credentials at rest (ADR-004). 32 random
# bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Without it the app still runs — LINE features simply refuse to connect and
# say so. Losing it means every connected Shop must paste its credentials
# again, so back it up like AUTH_SECRET.
LINE_CREDENTIALS_KEY=""
# Set only while rotating LINE_CREDENTIALS_KEY: the previous key, tried as a
# read-only fallback so existing rows stay readable mid-rotation.
#LINE_CREDENTIALS_KEY_PREVIOUS=""

# Which LINE transport to use: "fake" writes the exact payload it would have
# sent to .data/line/outbox.jsonl and charges nothing; "live" calls the real
# Messaging API. Unset means fake in development, live in production.
#LINE_TRANSPORT="fake"
#LINE_OUTBOX_PATH=".data/line/outbox.jsonl"

# --- Staging / production (Vercel) ---
# DATABASE_URL: the POOLED connection string from the hosted Postgres
# (Neon/Supabase). Migrations run at build time (vercel.json) and must
# bypass the pooler: set DIRECT_DATABASE_URL to the direct/unpooled URL
# (Neon-on-Vercel injects DATABASE_URL_UNPOOLED, which also works).
# BLOB_READ_WRITE_TOKEN: injected by connecting a Vercel Blob store —
# its presence switches photo storage from local disk to Blob.
#DIRECT_DATABASE_URL=""
#BLOB_READ_WRITE_TOKEN=""

# Only needed when AUTHORING a new migration (npm run db:migrate:new).
# The `npm run db:dev` server is single-store (all database names share one
# store), so migrate dev must use the dedicated shadow server it also starts —
# one port above the main TCP port (verify with: npx prisma dev ls).
# Applying existing migrations (npm run db:migrate) never needs this.
SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51215/automotiveoa?sslmode=disable"
